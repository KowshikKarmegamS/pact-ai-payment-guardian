# Database (SQLite file; on Render point this at the persistent disk, e.g. sqlite:////var/data/pact.db)
DATABASE_URL=sqlite:///./pact.db

# Recommendation AI. "auto" = Gemini if GEMINI_API_KEY is set, else OpenAI if OPENAI_API_KEY is set,
# else a clearly-labelled keyword heuristic (not AI). Can also be "gemini" or "openai".
AI_PROVIDER=auto
AI_TIMEOUT_SECONDS=20

# Google Gemini Developer API (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal

# OpenAI (optional, paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Must be a Sandbox host. Production endpoints are refused.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Single currency for catalog, mandates and PayPal orders. Never converted automatically.
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=20

# Public URL of the web app; PayPal returns the buyer here after checkout.
# Local dev (Vite): http://localhost:5173   Single-service / Render: https://<your-app>.onrender.com
APP_BASE_URL=http://localhost:5173

APP_SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
