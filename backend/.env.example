# Database (SQLite file; on Render point this at the persistent disk, e.g. sqlite:////var/data/pact.db)
DATABASE_URL=sqlite:///./pact.db

# Google Gemini Developer API (free tier): create a key at https://aistudio.google.com/apikey
# Without a key, recommendations use a clearly-labelled keyword heuristic (not AI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
AI_TIMEOUT_SECONDS=20

# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
# Channel3 live retailer search (https://docs.trychannel3.com). Empty = live search disabled.
# The key stays on the server: it is sent only in the x-api-key header to api.trychannel3.com.
CHANNEL3_API_KEY=
CHANNEL3_TIMEOUT_SECONDS=15
CHANNEL3_SYNC_QUERIES=wireless mechanical keyboard,usb-c hub,ergonomic wireless mouse

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Must be a Sandbox host. Production endpoints are refused.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Single currency for catalog, mandates and PayPal orders. Never converted automatically.
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_SECONDS=20

# Public URL of the web app; PayPal returns the buyer here after checkout.
# Local dev (Vite): http://localhost:5173   Single-service / Render: https://<your-app>.onrender.com
APP_BASE_URL=http://localhost:5173

APP_SECRET_KEY=change-this-to-a-random-secret

# Owner sign-in for the Control Center (mandates, approvals, payments, agents, audit).
# Empty = open local demo mode. Any public deployment must set a strong password.
OWNER_PASSWORD=
# true = refuse owner actions until OWNER_PASSWORD is set (fail closed). render.yaml sets this.
REQUIRE_OWNER_AUTH=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
